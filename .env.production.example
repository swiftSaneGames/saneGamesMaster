# Documentation only. The server reads environment variables, not this file.
# Store real values OUTSIDE the public checkout, readable only by the service account.
APP_MODE=production
BASE_URL=https://prod.sanegames.swiftsane.com
STUDIO_DATA_DIR=/absolute/private/path/to/sanegames-control
OWNER_GITHUB_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate locally: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# This token ONLY permits candidate/project intake; never human approval.
INTAKE_TOKEN=
# Links are displayed to the owner; the server never downloads them.
ARTIFACT_HOSTS=github.com,testflight.apple.com,play.google.com,appstoreconnect.apple.com
